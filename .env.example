# Copiar a .env y completar con valores reales.
SECRET_KEY=genera-un-valor-real

POSTGRES_DB=poolshop
POSTGRES_USER=poolshop
POSTGRES_PASSWORD=cambiame
# Puerto del host. Cambiar si ya hay un Postgres local en 5432 (ej. 5433).
POSTGRES_PORT=5432

# Frontend (host del link en los mails de recuperación)
FRONTEND_URL=http://localhost:5173

# Mail: sin EMAIL_HOST se usa la consola. Con EMAIL_HOST se usa SMTP.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=no-reply@poolshop.example
