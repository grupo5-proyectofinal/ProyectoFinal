# Copiar a .env y completar con valores reales.
SECRET_KEY=genera-un-valor-real

POSTGRES_DB=poolshop
POSTGRES_USER=poolshop
POSTGRES_PASSWORD=cambiame
# Puerto del host. Cambiar si ya hay un Postgres local en 5432 (ej. 5433).
POSTGRES_PORT=5432

# Frontend (host del link en los mails de recuperación)
FRONTEND_URL=http://localhost:5173

# Mail (recuperación de contraseña y notificaciones). Sin EMAIL_HOST se usa la
# consola (el mail se imprime en la terminal de runserver). Con EMAIL_HOST se usa
# SMTP. Para Gmail: activar la verificación en 2 pasos en la cuenta y generar una
# "contraseña de aplicación" (https://myaccount.google.com/apppasswords); esa clave
# de 16 letras va en EMAIL_HOST_PASSWORD (nunca la contraseña normal de la cuenta).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=poolshop_notificaciones@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PoolShop <poolshop_notificaciones@gmail.com>
