# Copiar a .env y completar con valores reales.
SECRET_KEY=genera-un-valor-real

POSTGRES_DB=poolshop
POSTGRES_USER=poolshop
POSTGRES_PASSWORD=cambiame
# Puerto del host. Cambiar si ya hay un Postgres local en 5432 (ej. 5433).
POSTGRES_PORT=5432

# Frontend (host del link en los mails de recuperación)
FRONTEND_URL=http://localhost:5173

# Verificación de email al registrarse. En true (recomendado) la cuenta queda
# pendiente hasta abrir el link del mail. En false la cuenta queda habilitada al
# crearse, no se manda el mail y se ingresa con usuario o email + contraseña.
VERIFICACION_EMAIL_OBLIGATORIA=true

# Mail (cuenta: verificación, bienvenida, contraseña; y notificaciones). Sin EMAIL_HOST se usa la
# consola (el mail se imprime en la terminal de runserver). Con EMAIL_HOST se usa
# SMTP. Para Gmail: activar la verificación en 2 pasos en la cuenta y generar una
# "contraseña de aplicación" (https://myaccount.google.com/apppasswords); esa clave
# de 16 letras va en EMAIL_HOST_PASSWORD (nunca la contraseña normal de la cuenta).
# Gmail no admite "_" en las direcciones.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=poolshopnotificaciones@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PoolShop <poolshopnotificaciones@gmail.com>

# Sesión (opcional): duración del access en minutos y del refresh en días.
# JWT_ACCESS_MINUTOS=30
# JWT_REFRESH_DIAS=14

# Hosts aceptados. En desarrollo (DEBUG=true) vacío = cualquiera, para probar
# desde el celular por la red local. En producción poné el dominio.
# ALLOWED_HOSTS=
